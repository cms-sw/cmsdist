### RPM external dyninst 13.0.0x
%define keep_archives true
%define tag d5adcef5fb64965beee445d16ce2a6f2c08c2496
%define branch dyninst_13
Source0: git+https://github.com/ROCm/%{n}.git?obj=%{branch}/%{tag}&export=%{n}-%{realversion}&output=/%{n}-%{realversion}-%{tag}.tgz
Source1: dyninst/DyninstConfig-DyninstTarget.cmake
BuildRequires: gmake cmake libiberty
Requires: boost tbb

%prep
%setup -n %{n}-%{realversion}

%build
rm -rf ../build; mkdir ../build ; cd ../build

cmake ../%{n}-%{realversion} \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX="%{i}" \
  -DCMAKE_PREFIX_PATH="%{cmake_prefix_path};${LIBIBERTY_ROOT}"

make %{makeprocesses} VERBOSE=1

%install
cd ../build
make install
rsync -a ../%{n}-%{realversion}/dyncompat/ %{i}/include/dyncompat/
test %{i}/lib/cmake/Dyninst/DyninstConfig.cmake
cat %{_sourcedir}/DyninstConfig-DyninstTarget.cmake >> %{i}/lib/cmake/Dyninst/DyninstConfig.cmake
