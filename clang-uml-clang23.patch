diff -ur pa/src/common/visitor/comment/clang_visitor.cc pb/src/common/visitor/comment/clang_visitor.cc
--- a/src/common/visitor/comment/clang_visitor.cc	2026-09-16 01:51:56.065915841 +0200
+++ b/src/common/visitor/comment/clang_visitor.cc	2026-09-16 01:51:56.065915841 +0200
@@ -37,8 +37,16 @@
 void clang_visitor::visit(
     const clang::NamedDecl &decl, common::model::decorated_element &e)
 {
+#if LLVM_VERSION_MAJOR < 23
     const auto *comment =
         decl.getASTContext().getRawCommentForDeclNoCache(&decl);
+#else
+    // LLVM 23 renamed the no-cache lookup and made it private; the public
+    // getRawCommentForAnyRedecl() is the supported way to fetch the raw
+    // comment attached to a declaration.
+    const auto *comment =
+        decl.getASTContext().getRawCommentForAnyRedecl(&decl);
+#endif
 
     if (comment == nullptr) {
         return;
