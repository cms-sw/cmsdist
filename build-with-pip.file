#File: with-with-pip
#pip_name: pip package name default is package name without starting py3
#pip_package_unpack_command: How to unpack package source default is use tar -xzf $PIPFILE
#PipDownloadSourceType: Only override the download source type e.g. none, all etc. Default is all
#PipDownloadOptions: override pip download sources options. Default is --no-deps%%20--no-binary%%3D:%%PipDownloadSourceType:
#PipBuildOptions: Override pip install options
#PipCommonOptions: Pip wheel/install common options
#PipWheelOptions: Option for pip wheel command
#PipInstallOptions: Options for pip install command
#PipWheelCommand Command to build package wheel
#PipInstallCommand Command to install the the wheel
#pkgsource: Override default source name e.g. src.tar.gz
#source0: Override default source
#Pip<Pre|Post><Section>: Extra macros to run extra commands for various sections e.g
#PipPostBuild to relocate hardcoded pyton paths e.g
### define PipPostBuild perl -p -i -e "s|^#!.*python|#!/usr/bin/env python|" %{i}/bin/*
#PipPackageNameCommand to get the exact package name
#PipDepsMatch Command to find out pypi package dependencies
#PipDepsCommand to get package dependencies

## INITENV +PATH PYTHON3PATH %{i}/${PYTHON3_LIB_SITE_PACKAGES}

%if "%{?pip_package_unpack_command:set}" != "set"
%define	pip_package_unpack_command tar -xzf ${PIPFILE}
%endif

%if "%{?pip_name:set}" != "set"
%define pip_name %(echo %n | cut -f2-10 -d-)
%endif
%if "%{?PipDownloadSourceType:set}" != "set"
%define PipDownloadSourceType all
%endif
%if "%{?PipDownloadOptions:set}" != "set"
%define PipDownloadOptions --no-deps%%20--no-binary%%3D:%{PipDownloadSourceType}:
%endif
%if "%{?PipBuildOptions:set}" != "set"
%define PipBuildOptions %{nil}
%endif
%if "%{?pkgsource:set}" != "set"
%define pkgsource source.tar.gz
%endif
%if "%{?PipCommonOptions:set}" != "set"
%define PipCommonOptions --progress-bar off --no-input --no-deps --no-index --no-cache-dir --disable-pip-version-check
%endif
%if "%{?PipWheelOptions:set}" != "set"
%define PipWheelOptions %{nil}
%endif
%if "%{?PipInstallOptions:set}" != "set"
%define PipInstallOptions %{nil}
%endif
%if "%{?PipDepsPost:set}" != "set"
%define PipDepsPost %{nil}
%endif
%if "%{?PipPackageNameCommand:set}" != "set"
%define PipPackageNameCommand pip3 show %{pip_name} --disable-pip-version-check | grep '^Name:' | sed 's|^Name: *||;s| ||g'
%endif
%if "%{?PipDepsMatch:set}" != "set"
%define PipDepsMatch grep "^${PKG_NAME}  *%{realversion}  *requires " | sed 's|,.*||;s|.* |py3-|'
%endif
%if "%{?PipDepsCommand:set}" != "set"
%define PipDepsCommand echo "${PIP_CHECK_OUTPUT}" | %{PipDepsMatch} %{PipDepsPost} | tr '\\n' ' '
%endif
%if "%{?PipWheelCommand:set}" != "set"
%define PipWheelCommand pip3 wheel %{PipCommonOptions} --no-build-isolation -v %{PipWheelOptions} -w ${PIP_WHEEL_DIR} %{PipBuildOptions} ${PIPFILE} 
%endif
%if "%{?PipInstallCommand:set}" != "set"
%define PipInstallCommand pip3 install %{PipCommonOptions} --user %{PipInstallOptions} ${PIP_WHEEL_FILE}
%endif

%define PipApplyPatch %{?patches:%patches}%{?patchsrc:1}%{?patchsrc0:1}%{?patchsrc1:1}%{?patchsrc2:1}%{?patchsrc3:1}%{?patchsrc4:1}
%define pip pip3&package_dependency=py3-pip
Requires: python3 py3-pip py3-setuptools

%if "%{?source0:set}" != "set"
%define source0 pip://%{pip_name}/%{realversion}?pip_options=%{PipDownloadOptions}&pip=%{pip}&output=/%{pkgsource}
%else
%define source_file %(echo '%{source0}' | sed 's|.*/||')
%endif

Source: %source0

%prep

%build
mkdir -p %{i}
%{?PipPrePrep:%PipPrePrep}
%if "%{?source_file:set}" != "set"
tar xfz %{_sourcedir}/%{pkgsource}
%else
cp %{_sourcedir}/%{source_file} %{source_file}
echo %{source_file}  > files.list
%endif

%{?PipPostPrep:%PipPostPrep}
%{?PipPreBuild:%PipPreBuild}

if [ $(cat files.list | wc -l) -ne 1 ] ; then
   echo "Sorry I don't know how to handle no/multiple install files yet"
   cat files.list
   exit 1
fi

PIPFILE=%{_builddir}/$(cat files.list)
PIP_BASENAME=$(basename -- "$PIPFILE")
PIP_EXT="${PIP_BASENAME##*.}"
%if "%{?NoAutoPatch:set}" != "set"
if [ "%{PipApplyPatch}" != "" ] ; then
  rm -rf cmsdist-pip-src; mkdir -p cmsdist-pip-src
  pushd cmsdist-pip-src
    %{pip_package_unpack_command}
    PIPFILE=%{_builddir}/cmsdist-pip-src/$(ls -d *)
    PIP_EXT=""
    pushd ${PIPFILE}
      for pch in %{?patches:%patches} ; do
        patch -p1 < ${pch}
      done
      %{?patchsrc:%patchsrc}
      %{?patchsrc0:%patchsrc0}
      %{?patchsrc1:%patchsrc1}
      %{?patchsrc2:%patchsrc2}
      %{?patchsrc3:%patchsrc3}
      %{?patchsrc4:%patchsrc4}
    popd
  popd
fi
%endif

echo ${PIPFILE} > %{_builddir}/files.list
export PYTHONUSERBASE=%{i}
pip3 list --format=columns --disable-pip-version-check
pip3 debug --verbose --disable-pip-version-check
%{?PipPreBuildPy:%PipPreBuildPy}

if [ "${PIP_EXT}" = "whl" ]; then
  PIP_WHEEL_FILE="${PIPFILE}"
else
  PIP_WHEEL_DIR=%{_builddir}/cmsdist-wheel
  rm -rf ${PIP_WHEEL_DIR}
  mkdir  ${PIP_WHEEL_DIR}
  echo "===== BUILDING WHEEL FOR %{pip_name} ====="
  echo "Using PIPFILE=${PIPFILE}"
  %{PipWheelCommand}
  WHEELS=($(find "${PIP_WHEEL_DIR}" -maxdepth 1 -name "*.whl"))
  if [ ${#WHEELS[@]} -eq 0 ]; then
    echo "ERROR: No wheel produced for %{pip_name}"
    exit 1
  elif [ ${#WHEELS[@]} -gt 1 ]; then
    echo "ERROR: Multiple wheels produced:"
    ls -l "${PIP_WHEEL_DIR}"/*.whl
    exit 1
  fi
  PIP_WHEEL_FILE="${WHEELS[0]}"
fi
echo "===== INSTALLING WHEEL ${PIP_WHEEL_FILE} ====="
%{PipInstallCommand}
PKG_NAME=$(%{PipPackageNameCommand})
[ "${PKG_NAME}" = "" ] && exit 1
echo "===== RUNNING pip check ====="
PIP_CHECK_OUTPUT=$(pip3 check --disable-pip-version-check || true)
DEPS=$(%{PipDepsCommand})
if [ "$DEPS" != "" ] ; then
  echo "ERROR: Missing dependencies for %n (python3) found: $DEPS"
  exit 1
fi
%{?PipPostBuildPy:%PipPostBuildPy}
%relocatePy3Shebang bin ${PYTHON3_LIB_SITE_PACKAGES} %{?RelocateShebandDirectory}
%{?PipPostBuild:%PipPostBuild}

#Install Section
%install
export PIPFILE=$(cat files.list)
%{?PipPreInstall:%PipPreInstall}
%{?PipPostInstall:%PipPostInstall}
[ ! -d %{i}/bin/__pycache__ ] || rm -rf %{i}/bin/__pycache__
chmod -R a+r %{i}
find %{i} -type d -print | xargs chmod 0755

#post Section
%post
%{?PipPrePost:%PipPrePost}
%{?PipPostPost:%PipPostPost}
