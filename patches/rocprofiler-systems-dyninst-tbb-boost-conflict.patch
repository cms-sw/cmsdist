@@ -155,7 +155,14 @@
     set(TBB_LIBRARY "${TBB_ROOT_DIR}/lib")
     set(TBB_INCLUDE_DIR "${TBB_ROOT_DIR}/include")
 
-    find_package(TBB ${TBB_MIN_VERSION} COMPONENTS ${_tbb_components})
+    # Force CONFIG mode so this always resolves through TBB's real TBBConfig.cmake
+    # (creating all of its exported targets, e.g. TBB::tbbbind_2_5, in one pass)
+    # instead of this project's legacy Modules/FindTBB.cmake, which only knows
+    # about tbb/tbbmalloc/tbbmalloc_proxy. Otherwise, when Dyninst's own installed
+    # tpls/DyninstTBB.cmake later calls find_package(TBB) again and resolves via
+    # the real TBBConfig.cmake, CMake's generated TBBTargets.cmake finds some but
+    # not all of its expected targets already defined and errors out.
+    find_package(TBB ${TBB_MIN_VERSION} CONFIG COMPONENTS ${_tbb_components})
 
     if(NOT TBB_FOUND)
         if(STERILE_BUILD)
