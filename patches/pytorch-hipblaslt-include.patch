diff --git a/cmake/public/LoadHIP.cmake b/cmake/public/LoadHIP.cmake
index 40aa87c65..616b99a6f 100644
--- a/cmake/public/LoadHIP.cmake
+++ b/cmake/public/LoadHIP.cmake
@@ -301,6 +301,7 @@ if(PYTORCH_FOUND_HIP)
   # These components will be searced for recursively in ${ROCM_PATH}
   message("\n***** Library versions from cmake find_package *****\n")
   find_package_and_print_version(amd_comgr REQUIRED)
+  find_package_and_print_version(hipblas-common REQUIRED)
   find_package_and_print_version(rocrand REQUIRED)
   find_package_and_print_version(hiprand REQUIRED)
   find_package_and_print_version(rocblas REQUIRED)
@@ -334,6 +335,32 @@ if(PYTORCH_FOUND_HIP)
   # Optional components.
   find_package_and_print_version(hipsparselt)  # Will be required when ready.
 
+  # Some ROCm packages use target-based includes (INTERFACE_INCLUDE_DIRECTORIES)
+  # instead of setting ${PACKAGE}_INCLUDE_DIR. Extract includes from these targets.
+  foreach(_rocm_target
+      roc::hipblas-common
+      roc::hipblaslt
+      roc::hipsparselt)
+    if(TARGET ${_rocm_target})
+      get_target_property(_target_includes ${_rocm_target} INTERFACE_INCLUDE_DIRECTORIES)
+      if(_target_includes)
+        list(APPEND ROCM_INCLUDE_DIRS ${_target_includes})
+      endif()
+    endif()
+  endforeach()
+
+  # rocm-core sets rocm_core_INCLUDE_DIR (underscore) not rocm-core_INCLUDE_DIR
+  if(rocm_core_INCLUDE_DIR)
+    list(APPEND ROCM_INCLUDE_DIRS ${rocm_core_INCLUDE_DIR})
+  endif()
+
+  # roctracer has no cmake config, search manually in CMAKE_PREFIX_PATH
+  foreach(_p ${CMAKE_PREFIX_PATH})
+    if(EXISTS "${_p}/include/roctracer/roctx.h")
+      list(APPEND ROCM_INCLUDE_DIRS "${_p}/include")
+    endif()
+  endforeach()
+
   list(REMOVE_DUPLICATES ROCM_INCLUDE_DIRS)
 
   if(UNIX)
