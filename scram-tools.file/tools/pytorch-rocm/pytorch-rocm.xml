<tool name="@TOOL@" version="@TOOL_VERSION@" revision="3">
  <client>
    <environment name="PYTORCH_ROCM_BASE" default="@TOOL_ROOT@"/>
    <environment name="INCLUDE" default="$PYTORCH_ROCM_BASE/@PYTHON3_LIB_SITE_PACKAGES@/torch/include"/>
    <environment name="LIBDIR" default="$PYTORCH_ROCM_BASE/@PYTHON3_LIB_SITE_PACKAGES@/torch/lib"/>
    <environment name="BINDIR" default="$PYTORCH_ROCM_BASE/bin"/>
  </client>

  <lib name="torch"/>
  <lib name="torch_cpu"/>
  <lib name="torch_rocm"/>
  <lib name="c10"/>
  <lib name="c10_cuda"/>
  <flags FORCE_LINK="1"/>
  <use name="rocm"/>
  <use name="torch-interface"/>
</tool>
