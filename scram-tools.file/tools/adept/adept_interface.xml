<tool name="adept_interface" version="@TOOL_VERSION@" revision="5">
  <info url="https://github.com/apt-sim/AdePT"/>
  <client>
    <environment name="ADEPT_INTERFACE_BASE" default="@TOOL_ROOT@"/>
    <environment name="INCLUDE" default="$ADEPT_INTERFACE_BASE/include"/>
    <environment name="LIBDIR" default="$ADEPT_INTERFACE_BASE/lib64"/>
  </client>
  <use name="geant4core"/>
  <use name="vecgeom"/>
  <use name="g4hepemcore"/>
  <flags CXXFLAGS="@CMS_ADEPT_CXX_FLAGS@"/>
</tool>
