  <client>
    <environment name="BINDIR" default="$TOOL_BASE/bin"/>
    <environment name="LIBDIR" default="$TOOL_BASE/lib64/SHERPA-MC3"/>
    <environment name="INCLUDE" default="$TOOL_BASE/include/SHERPA-MC3"/>
  </client>
  <!-- sherpa-3.0.5-libversioning.patch suffixes every library file name with
       the major version (libSherpaMain3.so, ...), so nothing collides with
       Sherpa 2 any more. Keep these 93 libraries out of the flat
       $CMSSW_BASE/external/$SCRAM_ARCH/lib area anyway: only users of this
       tool need them, and they are found via $LIBDIR and the install RPATH. -->
  <flags SKIP_TOOL_SYMLINKS="1"/>
  <runtime name="@OS_RUNTIME_LDPATH_NAME@" value="$LIBDIR" type="path"/>
  <runtime name="PATH" value="$BINDIR" type="path"/>
  <runtime name="CMSSW_FWLITE_INCLUDE_PATH" value="$TOOL_BASE/include" type="path"/>
  <runtime name="SHERPA3_SHARE_PATH" value="$TOOL_BASE/share/SHERPA-MC3" type="path"/>
  <runtime name="SHERPA3_INCLUDE_PATH" value="$TOOL_BASE/include/SHERPA-MC3" type="path"/>
  <runtime name="ROOT_INCLUDE_PATH" value="$INCLUDE" type="path"/>
  <runtime name="SHERPA3_LIBRARY_PATH" value="$TOOL_BASE/lib64/SHERPA-MC3" type="path"/>
  <runtime name="SHERPA3_CMAKE_PATH" value="$TOOL_BASE/share/SHERPA-MC3" type="path"/>
  <use name="HepMC3"/>
  <use name="lhapdf"/>
  <use name="blackhat"/>
  <use name="fastjet"/>
  <use name="openmpi"/>
  <use name="rivet"/>
  <use name="pythia8"/>
