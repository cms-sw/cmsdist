<tool revision="8">
  <info url="https://rocm.docs.amd.com/en/docs-@TOOL_REALVERSION@/"/>
  <lib name="amdhip64"/>
  <lib name="hsa-runtime64"/>
  <lib name="rocm_smi64"/>
  <flags CPPDEFINES="__HIP_PLATFORM_HCC__ __HIP_PLATFORM_AMD__"/>

  <flags ROCM_FLAGS="@ROCM_FLAGS@"/>
  <flags ROCM_FLAGS="-fgpu-rdc"/>
  <flags ROCM_FLAGS="-Wno-pass-failed"/>
%if "%{default_microarch_name}"
%if "%{default_microarch_name}" != "%{min_microarch_name}"
  <flags REM_ROCM_HOST_CXXFLAGS="-march=%%"/>
  <flags ROCM_HOST_CXXFLAGS="-march=%{min_microarch_name}"/>
%endif
%endif
  <runtime name="HSA_XNACK" value="1"/>
  <use name="fmt"/>
  <use name="hip"/>
  <use name="hiprand"/>
  <use name="rocm-core"/>
  <use name="rocm-llvm"/>
  <use name="rocm-rocprofiler-sdk"/>
  <use name="rocm-smi-lib"/>
  <use name="rocr-runtime"/>
  <use name="rocrand"/>
  <use name="rccl"/>
  <use name="rocprofiler-register"/>
  <use name="rocthrust"/>
  <use name="rocprim"/>
</tool>
