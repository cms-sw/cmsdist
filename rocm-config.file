### FILE rocm-config
# define the ROCm compilation flags in a way that can be shared by SCRAM-based and regular tools
## INCLUDE rocm-flags
%define rocm_version_num 7.2.2
%define rocm_version rocm-%{rocm_version_num}
%define rocm_systems_source https://github.com/ROCm/rocm-systems/releases/download/%{rocm_version}/
%define rocm_libraries_source https://github.com/ROCm/rocm-libraries/releases/download/%{rocm_version}/
%define rocm_targets $(sed 's/:sramecc+//g; s/ /;/g' <<< "%rocm_archs")