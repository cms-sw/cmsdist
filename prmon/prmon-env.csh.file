#####################################################
# **************** IMPORTANT NOTE ***************** #
# Increament Revision for every change              #
#####################################################
#CMSDIST_FILE_REVISION=2

set prmon_arch=`uname -m`
set latest_prmon=`ls -d @CMS_PATH@/share/${prmon_arch}/cms/prmon/v*/bin | sort | tail -1`
if ( $?PATH ) then
    setenv PATH "${latest_prmon}:$PATH"
else
    setenv PATH "${latest_prmon}"
endif
unset latest_prmon
unset prmon_arch
