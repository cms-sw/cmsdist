Requires: libzmq py3-packaging py3-scikit-build-core py3-typing-extensions py3-cython

# pyzmq >= 26 builds with scikit-build-core/CMake and ignores setup.cfg,
# so point its CMake project at our libzmq and forbid the bundled fallback
# (which downloads libzmq/libsodium sources and fails e.g. on riscv64).
%define PipPreBuild  export CMAKE_BUILD_PARALLEL_LEVEL=%{compiling_processes} ZMQ_PREFIX=${LIBZMQ_ROOT} PYZMQ_NO_BUNDLE=1 PYZMQ_LIBZMQ_RPATH=0
